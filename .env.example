# Optional .env (only useful when running from source).
# In production / via the .deb / .exe, configure everything from the
# Settings page in the UI — those values are saved to settings.json
# in the user data directory.

# Free tier key from https://aistudio.google.com/app/apikey
GOOGLE_API_KEY=

# Sender info (used to personalize generated outreach)
SENDER_NAME=
SENDER_COMPANY=
SENDER_WEBSITE=
SENDER_EMAIL=

# ---------------------------------------------------------------------------
# Supabase (cloud Postgres). The app is hard-wired to use Supabase — there is
# no SQLite fallback. Leave these unset to use the bundled default project,
# or set them to point at your own.
# ---------------------------------------------------------------------------
SUPABASE_URL=https://ailespxrkdfvureeleox.supabase.co
SUPABASE_ANON_KEY=sb_publishable_n5-DKZgPSLAoDN53NsdFdw_GLPLbhMF

# Set this if you want the app to derive the connection URL from
# SUPABASE_URL + this password (uses the IPv6-only direct host).
SUPABASE_DB_PASSWORD=

# Full Postgres URL — overrides everything above. Recommended: paste the
# IPv4-friendly pooler URL from Supabase → Settings → Database → Connection
# pooling. Example:
# DATABASE_URL=postgresql://postgres.PROJECT_REF:DB_PASSWORD@aws-0-REGION.pooler.supabase.com:5432/postgres

# Override the default data dir (settings.json + DB + screenshots)
# LUMORA_DATA_DIR=~/.local/share/lumora-pipeline
